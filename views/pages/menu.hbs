<style>
  .filter-btn { transition: all 0.3s ease; cursor: pointer; }
  .filter-btn:hover:not(.active) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(75, 46, 46, 0.15); border-color: #4b2e2e; }
  .filter-btn.active { background-color: #4b2e2e; color: #D4CCB2; border-color: #4b2e2e; box-shadow: 0 8px 20px rgba(75, 46, 46, 0.25); }

  /* Transform ở đây được bỏ để tránh xung đột với các class Tailwind hover:-translate-y / hover:scale
     đặt trực tiếp trên element .product-card — 2 nguồn transform cùng lúc sẽ cái này ghi đè cái kia. */
  .product-card { cursor: pointer; }

  .add-cart-btn { transition: all 0.3s ease; }
  .add-cart-btn:hover { background-color: #4b2e2e; color: #D4CCB2; letter-spacing: 0.5px; }

  .fade-in { animation: fadeIn 0.8s ease both; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

  .option-pill { transition: all 0.2s ease; cursor: pointer; }
  .option-pill.selected { background-color: #4b2e2e; color: #D4CCB2; border-color: #4b2e2e; }
  .size-card { transition: all 0.2s ease; cursor: pointer; }
  .size-card.selected { border-color: #c8a27a; background-color: rgba(200, 162, 122, 0.15); }
  .topping-check { transition: all 0.2s ease; cursor: pointer; }
  .topping-check.selected { border-color: #c8a27a; background-color: rgba(200, 162, 122, 0.15); }
  .qty-btn { transition: all 0.25s ease; }
  .qty-btn:hover { background-color: #4b2e2e; color: #D4CCB2; }
</style>

<section class="relative w-full h-auto mt-[70px]">
  <img src="/img/menu.jpg" alt="Menu" class="w-full h-auto object-contain">
</section>


<!-- ============ CATEGORY FILTER ============ -->
<section class="max-w-7xl mx-auto px-6 py-12">
  <div class="flex flex-wrap justify-center gap-3 mb-12" id="filterTabs">
    <button class="filter-btn active px-6 py-2.5 rounded-full border-2 border-brown font-medium text-sm" data-filter="all">All</button>
    <button class="filter-btn px-6 py-2.5 rounded-full border-2 border-brown/25 font-medium text-sm text-brown/70" data-filter="coffee">Coffee</button>
    <button class="filter-btn px-6 py-2.5 rounded-full border-2 border-brown/25 font-medium text-sm text-brown/70" data-filter="tea">Tea</button>
    <button class="filter-btn px-6 py-2.5 rounded-full border-2 border-brown/25 font-medium text-sm text-brown/70" data-filter="dessert">Dessert</button>
  </div>

  {{#if products.length}}
<!-- ============ PRODUCT GRID (render động từ MongoDB) ============ -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="productGrid">
  {{#each products}}
  <div class="product-card group relative bg-white rounded-[28px] overflow-hidden
              border border-brown/8 shadow-[0_4px_20px_-4px_rgba(75,46,46,0.15)]
              hover:shadow-[0_20px_40px_-8px_rgba(75,46,46,0.25)] hover:-translate-y-1.5
              transition-all duration-500 ease-out"
       data-category="{{this.category}}"
       data-id="{{this.productId}}"
       data-name="{{this.name}}"
       data-price="{{this.basePrice}}"
       data-flavor="{{this.flavor}}">

    <!-- Badge -->
    {{#unless (eq this.badge 'none')}}
      <span class="absolute top-4 left-4 z-10 text-[11px] font-bold px-3 py-1.5 rounded-full
                    shadow-md backdrop-blur-sm tracking-wide
                    {{#if (eq this.badge 'best-seller')}}bg-accent/90 text-brown{{else}}bg-brown/90 text-cream{{/if}}">
        {{#if (eq this.badge 'best-seller')}}🔥 Best Seller{{else}}✨ New{{/if}}
      </span>
    {{/unless}}

    <!-- Image with zoom-on-hover -->
    <div class="relative overflow-hidden aspect-[4/3] rounded-t-[28px]">
      <img src="{{this.image}}" alt="{{this.name}}"
           class="product-img w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" />
      <div class="absolute inset-0 bg-gradient-to-t from-brown/30 via-transparent to-transparent"></div>

      <!-- Quick add button — hiện khi hover, gọn hơn nút full-width bên dưới -->
      <button type="button"
              class="add-cart-btn hidden sm:flex absolute bottom-4 right-4 w-11 h-11 items-center justify-center
                     bg-accent text-brown rounded-full shadow-lg ring-1 ring-white/40
                     opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0
                     transition-all duration-300 hover:scale-110 active:scale-90">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m-10 0a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4z" />
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="p-5 pt-4">
      {{#if this.flavor}}
        <span class="inline-block text-[10.5px] uppercase tracking-[0.12em] text-brown/45 font-semibold mb-1.5">
          {{this.flavor}}
        </span>
      {{/if}}

      <h3 class="font-heading text-[17px] font-semibold text-brown leading-snug mb-3">
        {{this.name}}
      </h3>

      <div class="flex items-center justify-between">
        <span class="text-lg font-bold text-brown tracking-tight">{{formatVND this.basePrice}}</span>
        <button class="add-cart-btn sm:hidden flex items-center gap-1.5 bg-accent text-brown px-4 py-2
                       rounded-full text-sm font-semibold shadow-md active:scale-90 transition-transform"
                type="button">
          Thêm
        </button>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="text-center py-20">
  <p class="text-brown/60">Chưa có sản phẩm nào. Vui lòng quay lại sau.</p>
</div>
{{/if}}
</section>
{{! ============ PRODUCT DETAIL MODAL ============ }}
<div id="productModal" class="fixed inset-0 z-[100] hidden items-center justify-center px-4 py-8">
  <div id="productModalOverlay" class="absolute inset-0 bg-brown/70 backdrop-blur-sm"></div>
  <div class="relative bg-cream w-full max-w-2xl rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h3 id="modalProductName" class="font-heading text-2xl font-bold text-brown">Tên sản phẩm</h3>
          <p id="modalProductFlavor" class="text-brown/70 text-sm mt-2 leading-relaxed">Mô tả hương vị</p>
        </div>
        <button id="closeProductModalBtn" type="button" class="text-brown/50 hover:text-brown transition-colors flex-shrink-0 ml-4" aria-label="Đóng">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <img id="modalProductImage" src="/img/latte.png" alt="" class="w-full h-48 object-cover rounded-xl mb-6" />

      <div id="modalDrinkOptions">
        <div class="mb-6">
          <label class="block text-sm font-semibold text-brown mb-3">Kích cỡ</label>
          <div class="grid grid-cols-3 gap-3" id="sizeOptions">
            <div class="size-card border-2 border-brown/20 rounded-xl p-3 text-center" data-value="S" data-modifier="0">
              <div class="font-heading font-semibold text-brown">S</div>
              <div class="text-xs text-brown/60 mt-1">240-300ml</div>
            </div>
            <div class="size-card border-2 border-brown/20 rounded-xl p-3 text-center" data-value="M" data-modifier="10000">
              <div class="font-heading font-semibold text-brown">M</div>
              <div class="text-xs text-brown/60 mt-1">360-450ml</div>
              <div class="text-xs text-accent font-medium mt-0.5">+10.000₫</div>
            </div>
            <div class="size-card border-2 border-brown/20 rounded-xl p-3 text-center" data-value="L" data-modifier="20000">
              <div class="font-heading font-semibold text-brown">L</div>
              <div class="text-xs text-brown/60 mt-1">500-600ml</div>
              <div class="text-xs text-accent font-medium mt-0.5">+20.000₫</div>
            </div>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-semibold text-brown mb-3">Đá</label>
          <div class="flex flex-wrap gap-2" id="iceOptions">
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="normal">Đá bình thường</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="none">Không đá</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="separate">Đá riêng</div>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-semibold text-brown mb-3">Đường</label>
          <div class="flex flex-wrap gap-2" id="sugarOptions">
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="normal">100% đường</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="less50">Giảm 50%</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="less70">Giảm 70%</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="none">Không đường</div>
            <div class="option-pill border-2 border-brown/20 rounded-full px-4 py-2 text-sm text-brown" data-value="extra">Thêm đường</div>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-semibold text-brown mb-3">Topping (tuỳ chọn)</label>
          <div class="grid grid-cols-2 gap-3" id="toppingOptions">
  {{#each toppings}}
  <div class="topping-check border-2 border-brown/20 rounded-xl px-4 py-3 flex items-center justify-between" data-value="{{this._id}}" data-price="{{this.price}}">
    <span class="text-sm text-brown">{{this.name}}</span><span class="text-xs text-accent font-medium">+{{formatVND this.price}}</span>
  </div>
  {{/each}}
</div>
        </div>
      </div>

      <div class="mb-6">
        <label for="modalNote" class="block text-sm font-semibold text-brown mb-2">Ghi chú</label>
        <textarea id="modalNote" rows="2" maxlength="200" placeholder="Ví dụ: ít đá, không ống hút..." class="w-full px-4 py-3 rounded-lg border border-brown/20 bg-white text-brown placeholder-brown/40 text-sm resize-none"></textarea>
      </div>

      <div class="flex items-center justify-between border-t border-brown/10 pt-6">
        <div class="flex items-center gap-3">
          <button id="modalQtyDecrease" type="button" class="qty-btn w-9 h-9 flex items-center justify-center rounded-full border border-brown text-brown font-bold">−</button>
          <span id="modalQtyValue" class="w-6 text-center font-semibold text-brown">1</span>
          <button id="modalQtyIncrease" type="button" class="qty-btn w-9 h-9 flex items-center justify-center rounded-full border border-brown text-brown font-bold">+</button>
        </div>
        <span id="modalTotalPrice" class="font-heading text-2xl font-bold text-accent">0₫</span>
      </div>

      <button id="modalAddToCartBtn" type="button" class="w-full mt-6 bg-brown text-cream font-semibold py-3.5 rounded-full shadow-lg hover:bg-accent hover:text-brown transition-all duration-300">
        Thêm vào giỏ hàng
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const products = document.querySelectorAll('#productGrid > div');

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('active', 'bg-brown', 'text-cream'); });
        btn.classList.add('active', 'bg-brown', 'text-cream');
        const filter = btn.dataset.filter;
        products.forEach(function (product) {
          product.style.display = (filter === 'all' || product.dataset.category === filter) ? '' : 'none';
        });
      });
    });

    const modal = document.getElementById('productModal');
    const modalOverlay = document.getElementById('productModalOverlay');
    const closeModalBtn = document.getElementById('closeProductModalBtn');
    const modalDrinkOptions = document.getElementById('modalDrinkOptions');
    const modalProductName = document.getElementById('modalProductName');
    const modalProductFlavor = document.getElementById('modalProductFlavor');
    const modalProductImage = document.getElementById('modalProductImage');
    const modalNote = document.getElementById('modalNote');
    const modalQtyValue = document.getElementById('modalQtyValue');
    const modalTotalPrice = document.getElementById('modalTotalPrice');
    const modalAddToCartBtn = document.getElementById('modalAddToCartBtn');

    let currentProduct = null;
    let currentQty = 1;
    let selectedSize = 'S';
    let selectedIce = 'normal';
    let selectedSugar = 'normal';
    let selectedToppings = [];

    function resetModalSelections() {
      currentQty = 1;
      selectedSize = 'S'; selectedIce = 'normal'; selectedSugar = 'normal'; selectedToppings = [];
      modalNote.value = '';
      modalQtyValue.textContent = '1';
      document.querySelectorAll('.size-card').forEach(function (el) { el.classList.remove('selected'); });
      document.querySelector('.size-card[data-value="S"]').classList.add('selected');
      document.querySelectorAll('#iceOptions .option-pill').forEach(function (el) { el.classList.remove('selected'); });
      document.querySelector('#iceOptions .option-pill[data-value="normal"]').classList.add('selected');
      document.querySelectorAll('#sugarOptions .option-pill').forEach(function (el) { el.classList.remove('selected'); });
      document.querySelector('#sugarOptions .option-pill[data-value="normal"]').classList.add('selected');
      document.querySelectorAll('.topping-check').forEach(function (el) { el.classList.remove('selected'); });
    }

    function calculateModalPrice() {
      if (!currentProduct) return 0;
      let price = currentProduct.price;
      if (currentProduct.category !== 'dessert') {
        const sizeCard = document.querySelector('.size-card[data-value="' + selectedSize + '"]');
        price += parseFloat(sizeCard.dataset.modifier);
        selectedToppings.forEach(function (v) {
          const el = document.querySelector('.topping-check[data-value="' + v + '"]');
          if (el) price += parseFloat(el.dataset.price);
        });
      }
      return price * currentQty;
    }

    function updateModalTotal() {
      modalTotalPrice.textContent = Math.round(calculateModalPrice()).toLocaleString('vi-VN') + '₫';
    }

    function openProductModal(card) {
      currentProduct = {
        id: card.dataset.id, name: card.dataset.name, price: parseFloat(card.dataset.price),
        category: card.dataset.category, image: card.querySelector('img').src
      };
      modalProductName.textContent = currentProduct.name;
      modalProductFlavor.textContent = card.dataset.flavor || '';
      modalProductImage.src = currentProduct.image;
      modalProductImage.alt = currentProduct.name;
      modalDrinkOptions.style.display = currentProduct.category === 'dessert' ? 'none' : 'block';
      resetModalSelections();
      updateModalTotal();
      modal.classList.remove('hidden'); modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeProductModal() {
      modal.classList.add('hidden'); modal.classList.remove('flex');
      document.body.style.overflow = ''; currentProduct = null;
    }

    products.forEach(function (card) { card.addEventListener('click', function () { openProductModal(card); }); });
    closeModalBtn.addEventListener('click', closeProductModal);
    modalOverlay.addEventListener('click', closeProductModal);

    document.querySelectorAll('.size-card').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.stopPropagation();
        document.querySelectorAll('.size-card').forEach(function (s) { s.classList.remove('selected'); });
        el.classList.add('selected'); selectedSize = el.dataset.value; updateModalTotal();
      });
    });

    document.querySelectorAll('#iceOptions .option-pill').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.stopPropagation();
        document.querySelectorAll('#iceOptions .option-pill').forEach(function (s) { s.classList.remove('selected'); });
        el.classList.add('selected'); selectedIce = el.dataset.value;
      });
    });

    document.querySelectorAll('#sugarOptions .option-pill').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.stopPropagation();
        document.querySelectorAll('#sugarOptions .option-pill').forEach(function (s) { s.classList.remove('selected'); });
        el.classList.add('selected'); selectedSugar = el.dataset.value;
      });
    });

    document.querySelectorAll('.topping-check').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.stopPropagation();
        el.classList.toggle('selected');
        const value = el.dataset.value;
        if (el.classList.contains('selected')) { selectedToppings.push(value); }
        else { selectedToppings = selectedToppings.filter(function (t) { return t !== value; }); }
        updateModalTotal();
      });
    });

    document.getElementById('modalQtyIncrease').addEventListener('click', function (e) {
      e.stopPropagation(); currentQty += 1; modalQtyValue.textContent = currentQty; updateModalTotal();
    });
    document.getElementById('modalQtyDecrease').addEventListener('click', function (e) {
      e.stopPropagation(); currentQty = Math.max(1, currentQty - 1); modalQtyValue.textContent = currentQty; updateModalTotal();
    });

    modalAddToCartBtn.addEventListener('click', async function (e) {
      e.stopPropagation();
      if (!currentProduct) return;

      const payload = {
        productId: currentProduct.id, size: selectedSize, ice: selectedIce, sugarLevel: selectedSugar,
        toppings: selectedToppings, note: modalNote.value.trim(), quantity: currentQty
      };

      modalAddToCartBtn.disabled = true;
      const originalText = modalAddToCartBtn.textContent;
      modalAddToCartBtn.textContent = 'Đang thêm...';

      try {
        const res = await fetch('/cart/add', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
        });

        if (res.status === 401) {
          const data = await res.json();
          window.location.href = data.redirectUrl;
          return;
        }

        const data = await res.json();

        if (data.success) {
          if (window.updateCartBadge) window.updateCartBadge(data.totalQuantity);
          modalAddToCartBtn.textContent = 'Đã thêm ✓';
          setTimeout(function () {
            closeProductModal();
            modalAddToCartBtn.textContent = originalText;
            modalAddToCartBtn.disabled = false;
          }, 800);
        } else {
          alert(data.message || 'Có lỗi xảy ra.');
          modalAddToCartBtn.textContent = originalText;
          modalAddToCartBtn.disabled = false;
        }
      } catch (err) {
        console.error('Lỗi khi thêm vào giỏ hàng:', err);
        modalAddToCartBtn.textContent = originalText;
        modalAddToCartBtn.disabled = false;
      }
    });

    // ============ QUICK ADD-TO-CART (nút nhỏ trên card) + ANIMATION BAY VÀO GIỎ ============
    // Nút "add-cart-btn" nằm TRONG mỗi card, mà cả card cũng có onclick mở modal (openProductModal).
    // Nếu không stopPropagation ở đây, bấm nút này sẽ vừa gọi API vừa mở modal luôn — phải chặn từ
    // chính element nút (target phase), không phải delegate lên #productGrid, vì lúc đó sự kiện
    // bubble đã đi qua card (ancestor) trước rồi, stopPropagation ở tầng ngoài sẽ quá muộn.
    function flyToCart(imgEl, targetEl) {
      const imgRect = imgEl.getBoundingClientRect();
      const targetRect = targetEl.getBoundingClientRect();

      const clone = imgEl.cloneNode(true);
      clone.style.position = 'fixed';
      clone.style.top = imgRect.top + 'px';
      clone.style.left = imgRect.left + 'px';
      clone.style.width = imgRect.width + 'px';
      clone.style.height = imgRect.height + 'px';
      clone.style.borderRadius = '16px';
      clone.style.zIndex = '9999';
      clone.style.pointerEvents = 'none';
      clone.style.transition = 'all 0.7s cubic-bezier(0.55, 0, 0.1, 1)';
      document.body.appendChild(clone);

      // Bắt buộc đổi style ở frame kế tiếp, không thì browser không nhận ra đây là 1 transition
      requestAnimationFrame(function () {
        clone.style.top = (targetRect.top + targetRect.height / 2) + 'px';
        clone.style.left = (targetRect.left + targetRect.width / 2) + 'px';
        clone.style.width = '0px';
        clone.style.height = '0px';
        clone.style.opacity = '0.3';
      });

      clone.addEventListener('transitionend', function () {
        clone.remove();
        targetEl.classList.add('scale-125');
        setTimeout(function () { targetEl.classList.remove('scale-125'); }, 250);
      }, { once: true });
    }

    document.querySelectorAll('.add-cart-btn').forEach(function (btn) {
      btn.addEventListener('click', async function (e) {
        e.stopPropagation();

        const card = btn.closest('.product-card');
        const img = card.querySelector('.product-img');
        // TODO: đổi selector này đúng với icon giỏ hàng thật trong header/layout của bạn
        const cartIcon = document.querySelector('#cartIcon, [data-cart-icon]');
        if (cartIcon) flyToCart(img, cartIcon);

        btn.disabled = true;

        try {
          const res = await fetch('/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              productId: card.dataset.id,
              size: 'S', ice: 'normal', sugarLevel: 'normal',
              toppings: [], note: '', quantity: 1
            })
          });

          if (res.status === 401) {
            const data = await res.json();
            window.location.href = data.redirectUrl;
            return;
          }

          const data = await res.json();

          // Cập nhật số lượng LẤY TỪ SERVER (data.totalQuantity), không tự cộng ở client —
          // để tránh badge hiển thị sai nếu request add-cart thật ra bị lỗi.
          if (data.success) {
            if (window.updateCartBadge) window.updateCartBadge(data.totalQuantity);
          } else {
            alert(data.message || 'Có lỗi xảy ra.');
          }
        } catch (err) {
          console.error('Lỗi khi thêm nhanh vào giỏ hàng:', err);
        } finally {
          btn.disabled = false;
        }
      });
    });
  });
</script>
