<script>
  document.addEventListener('DOMContentLoaded', function () {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const products = document.querySelectorAll('#productGrid > div');
    const cartBadge = document.getElementById('cartBadge');

    function updateCartBadge(count) {
      if (!cartBadge) return;
      const safeCount = Number(count) || 0;
      cartBadge.textContent = safeCount > 10 ? '10+' : safeCount;
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active', 'bg-brown', 'text-cream'));
        btn.classList.add('active', 'bg-brown', 'text-cream');

        const filter = btn.dataset.filter;
        products.forEach(product => {
          if (filter === 'all' || product.dataset.category === filter) {
            product.style.display = '';
          } else {
            product.style.display = 'none';
          }
        });
      });
    });

    // ====== ADD TO CART ======
    document.querySelectorAll('.add-cart-btn').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        const card = btn.closest('.product-card');
 
        const payload = {
          productId: card.dataset.id,
          name: card.dataset.name,
          price: parseFloat(card.dataset.price),
          quantity: 1
        };
 
        // Disable nút tạm thời để tránh double-click
        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = 'Đang thêm...';
 
        try {
          const res = await fetch('/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
 
          // Chưa đăng nhập -> middleware trả về 401 kèm redirectUrl
          if (res.status === 401) {
            const data = await res.json();
            window.location.href = data.redirectUrl; // chuyển sang /login?redirect=/menu
            return;
          }
 
          const data = await res.json();
 
          if (data.success) {
            updateCartBadge(data.totalQuantity);
            btn.textContent = 'Đã thêm ✓';
            setTimeout(function () {
              btn.textContent = originalText;
              btn.disabled = false;
            }, 1200);
          } else {
            alert(data.message || 'Có lỗi xảy ra.');
            btn.textContent = originalText;
            btn.disabled = false;
          }
 
        } catch (err) {
          console.error('Lỗi khi thêm vào giỏ hàng:', err);
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });
    });
 
    // ====== CẬP NHẬT BADGE GIỎ HÀNG REALTIME ======
    function updateCartBadge(count) {
      const badge = document.getElementById('cartBadge');
      if (!badge) return;
      badge.textContent = count > 10 ? '10+' : count;
    }
 
  });
</script>
 