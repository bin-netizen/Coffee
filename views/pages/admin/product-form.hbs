<h1 class="font-heading text-3xl font-bold text-brown mb-8">{{#if isEdit}}Sửa sản phẩm{{else}}Thêm sản phẩm mới{{/if}}</h1>

{{#if error}}
  <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-6 max-w-2xl">{{error}}</div>
{{/if}}

<form action="{{#if isEdit}}/admin/products/{{product._id}}{{else}}/admin/products{{/if}}" method="POST" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-2xl space-y-5">

  {{#unless isEdit}}
  <div>
    <label class="block text-sm font-medium text-brown mb-2">Mã sản phẩm (productId, không dấu, không khoảng trắng)</label>
    <input type="text" name="productId" placeholder="vd: caramel-latte" class="w-full px-4 py-3 rounded-lg border border-gray-200" required />
  </div>
  {{/unless}}

  <div>
    <label class="block text-sm font-medium text-brown mb-2">Tên sản phẩm</label>
    <input type="text" name="name" value="{{product.name}}" class="w-full px-4 py-3 rounded-lg border border-gray-200" required />
  </div>

  <div class="grid grid-cols-2 gap-5">
    <div>
      <label class="block text-sm font-medium text-brown mb-2">Danh mục</label>
      <select name="category" class="w-full px-4 py-3 rounded-lg border border-gray-200">
        <option value="coffee" {{#eq product.category 'coffee'}}selected{{/eq}}>Coffee</option>
        <option value="tea" {{#eq product.category 'tea'}}selected{{/eq}}>Tea</option>
        <option value="dessert" {{#eq product.category 'dessert'}}selected{{/eq}}>Dessert</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-brown mb-2">Giá gốc (VND)</label>
    <input 
      type="number" 
      step="1000" 
      min="0" 
      name="basePrice" 
      value="{{product.basePrice}}" 
      laceholder="vd: 45000"
      class="w-full px-4 py-3 rounded-lg border border-gray-200" 
      required
    />
  </div>

  <div>
    <label class="block text-sm font-medium text-brown mb-2">Mô tả hương vị</label>
    <textarea name="flavor" rows="3" class="w-full px-4 py-3 rounded-lg border border-gray-200">{{product.flavor}}</textarea>
  </div>

  <div>
    <label class="block text-sm font-medium text-brown mb-2">Đường dẫn ảnh</label>
    <input type="text" name="image" value="{{#if product.image}}{{product.image}}{{else}}/img/latte.png{{/if}}" class="w-full px-4 py-3 rounded-lg border border-gray-200" />
  </div>

  <div>
    <label class="block text-sm font-medium text-brown mb-2">Nhãn</label>
    <select name="badge" class="w-full px-4 py-3 rounded-lg border border-gray-200">
      <option value="none" {{#eq product.badge 'none'}}selected{{/eq}}>Không có</option>
      <option value="best-seller" {{#eq product.badge 'best-seller'}}selected{{/eq}}>Best Seller</option>
      <option value="new" {{#eq product.badge 'new'}}selected{{/eq}}>New</option>
    </select>
  </div>

  {{#if isEdit}}
  <label class="flex items-center gap-2 text-sm text-brown">
    <input type="checkbox" name="isActive" {{#if product.isActive}}checked{{/if}} class="accent-accent w-4 h-4" />
    Đang hiển thị trên menu
  </label>
  {{/if}}

  <div class="flex gap-3 pt-4">
    <button type="submit" class="bg-brown text-cream px-6 py-3 rounded-lg font-medium hover:bg-accent hover:text-brown transition-colors">
      {{#if isEdit}}Cập nhật{{else}}Tạo sản phẩm{{/if}}
    </button>
    <a href="/admin/products" class="px-6 py-3 rounded-lg font-medium border border-gray-200 text-brown hover:bg-gray-50 transition-colors">Huỷ</a>
  </div>
</form>
