<div class="mb-8">
  <h1 class="font-heading text-2xl font-bold text-brown">Thống kê bán hàng hôm nay</h1>
  <p class="text-brown/50 text-sm mt-1">Ngày: {{dateLabel}}</p>
</div>

{{#if error}}
<div class="mb-6 px-4 py-3 rounded-lg bg-red-50 text-red-600 text-sm">{{error}}</div>
{{/if}}

<!-- ============ TỔNG QUAN ============ -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-2xl shadow-sm p-5">
    <p class="text-xs text-brown/50 uppercase font-medium mb-1">Tổng số ly</p>
    <p class="text-3xl font-bold text-brown">{{totalCups}}</p>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-5">
    <p class="text-xs text-brown/50 uppercase font-medium mb-1">Size S</p>
    <p class="text-3xl font-bold text-brown">{{sizeS}}</p>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-5">
    <p class="text-xs text-brown/50 uppercase font-medium mb-1">Size M</p>
    <p class="text-3xl font-bold text-brown">{{sizeM}}</p>
  </div>
  <div class="bg-white rounded-2xl shadow-sm p-5">
    <p class="text-xs text-brown/50 uppercase font-medium mb-1">Size L</p>
    <p class="text-3xl font-bold text-brown">{{sizeL}}</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-10">
  <div class="bg-accent/10 rounded-2xl shadow-sm p-5 md:col-span-1">
    <p class="text-xs text-brown/50 uppercase font-medium mb-1">Tổng số topping đã bán</p>
    <p class="text-3xl font-bold text-brown">{{totalToppings}}</p>
  </div>
</div>

<!-- ============ SẢN PHẨM ĐÃ BÁN ============ -->
<div class="bg-white rounded-2xl shadow-sm overflow-hidden mb-10">
  <div class="px-6 py-4 border-b border-gray-100 font-semibold text-brown">Sản phẩm đã bán</div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 text-gray-500 uppercase text-xs">
          <th class="px-6 py-3 text-left font-medium">Sản phẩm</th>
          <th class="px-6 py-3 text-center font-medium">S</th>
          <th class="px-6 py-3 text-center font-medium">M</th>
          <th class="px-6 py-3 text-center font-medium">L</th>
          <th class="px-6 py-3 text-center font-medium">Tổng</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {{#each productStats}}
        <tr class="{{#if (eq this.total 0)}}text-gray-300{{else}}text-brown{{/if}}">
          <td class="px-6 py-3">{{this.name}}</td>
          <td class="px-6 py-3 text-center">{{#if this.isDrink}}{{this.S}}{{else}}—{{/if}}</td>
          <td class="px-6 py-3 text-center">{{#if this.isDrink}}{{this.M}}{{else}}—{{/if}}</td>
          <td class="px-6 py-3 text-center">{{#if this.isDrink}}{{this.L}}{{else}}—{{/if}}</td>
          <td class="px-6 py-3 text-center font-semibold">{{this.total}}</td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="px-6 py-8 text-center text-gray-400">Không có sản phẩm nào đang bán.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<!-- ============ TOPPING ĐÃ BÁN ============ -->
<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100 font-semibold text-brown">Topping đã bán</div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 text-gray-500 uppercase text-xs">
          <th class="px-6 py-3 text-left font-medium">Topping</th>
          <th class="px-6 py-3 text-center font-medium">Số lượng</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {{#each toppingStats}}
        <tr class="{{#if (eq this.quantity 0)}}text-gray-300{{else}}text-brown{{/if}}">
          <td class="px-6 py-3">{{this.name}}</td>
          <td class="px-6 py-3 text-center font-semibold">{{this.quantity}}</td>
        </tr>
        {{else}}
        <tr><td colspan="2" class="px-6 py-8 text-center text-gray-400">Không có topping nào đang bán.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
