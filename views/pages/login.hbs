<style>
  .fade-up {
    animation: fadeUp 0.8s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .auth-input {
    transition: all 0.3s ease;
  }
  .auth-input:focus {
    outline: none;
    border-color: #c8a27a;
    box-shadow: 0 0 0 3px rgba(200, 162, 122, 0.25);
  }

  .auth-btn {
    transition: all 0.3s ease;
  }
  .auth-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(75, 46, 46, 0.35);
  }

  .social-btn {
    transition: all 0.25s ease;
  }
  .social-btn:hover {
    background-color: rgba(75, 46, 46, 0.05);
    border-color: #4b2e2e;
  }
</style>

<!-- ============ LOGIN SECTION ============ -->
<section class="min-h-screen flex items-center justify-center px-6 py-28 bg-cream">
  <div class="max-w-5xl w-full grid grid-cols-1 lg:grid-cols-2 rounded-3xl overflow-hidden shadow-2xl fade-up">

    <!-- Image side -->
    <div
      class="hidden lg:block relative bg-cover bg-center"
      style="background-image: url('/img/home.png');"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-brown/90 via-brown/50 to-brown/20"></div>
      <div class="relative z-10 h-full flex flex-col justify-end p-10 text-cream">
        <span class="text-accent font-semibold tracking-widest uppercase text-sm mb-3">Chào mừng trở lại</span>
        <h2 class="font-heading text-3xl font-bold mb-3">Rất vui được gặp lại bạn</h2>
        <p class="text-cream/80 text-sm leading-relaxed">
          Đăng nhập để theo dõi đơn hàng, tích điểm thành viên và nhận ưu đãi
          dành riêng cho bạn tại CoffeeWeb.
        </p>
      </div>
    </div>

    <!-- Form side -->
    <div class="bg-white/70 backdrop-blur-sm p-8 sm:p-12 flex flex-col justify-center">
      <div class="flex items-center gap-3 mb-8">
        <img src="/img/icon.png" alt="CoffeeWeb Logo" class="h-9 w-9 object-contain" />
        <span class="font-heading text-xl font-bold text-brown">CoffeeWeb</span>
      </div>

      <h1 class="font-heading text-3xl font-bold text-brown mb-2">Đăng nhập</h1>
          {{#if successMessage}}
      <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
        {{successMessage}}
      </div>
    {{/if}}
 
    {{#if error}}
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
        {{error}}
      </div>
    {{/if}}
    
      <p class="text-brown/60 text-sm mb-8">
        Chưa có tài khoản?
        <a href="/register?redirect={{redirect}}" class="text-accent font-semibold hover:underline">Đăng ký ngay</a>
      </p>

      <form action="/login" method="POST" class="space-y-5">
      <input type="hidden" name="redirect" value="{{redirect}}" />
        <div>
          <label for="email" class="block text-sm font-medium text-brown mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            class="auth-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white text-brown placeholder-brown/40"
            required
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-brown mb-2">Mật khẩu</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            class="auth-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white text-brown placeholder-brown/40"
            required
          />
        </div>

        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 text-brown/70 cursor-pointer">
            <input type="checkbox" name="remember" class="accent-accent w-4 h-4" />
            Ghi nhớ đăng nhập
          </label>
          <a href="/forgot-password" class="text-accent font-medium hover:underline">Quên mật khẩu?</a>
        </div>

        <button
          type="submit"
          class="auth-btn w-full bg-brown text-cream font-semibold py-3.5 rounded-full shadow-lg hover:bg-accent hover:text-brown transition-all duration-300"
        >
          Đăng nhập
        </button>
      </form>

      <div class="flex items-center gap-4 my-8">
        <div class="flex-1 h-px bg-brown/15"></div>
        <span class="text-brown/40 text-xs uppercase tracking-wide">Hoặc tiếp tục với</span>
        <div class="flex-1 h-px bg-brown/15"></div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <button class="social-btn flex items-center justify-center gap-2 border border-brown/20 rounded-lg py-2.5 text-sm font-medium text-brown">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12 10.2v3.92h5.5c-.24 1.36-1.68 4-5.5 4-3.32 0-6.02-2.74-6.02-6.12S8.68 5.88 12 5.88c1.9 0 3.16.8 3.88 1.5l2.64-2.54C16.9 3.24 14.66 2.2 12 2.2 6.98 2.2 2.9 6.28 2.9 11.3s4.08 9.1 9.1 9.1c5.26 0 8.74-3.7 8.74-8.9 0-.6-.06-1.06-.14-1.5H12z"/>
          </svg>
          Google
        </button>
        <button class="social-btn flex items-center justify-center gap-2 border border-brown/20 rounded-lg py-2.5 text-sm font-medium text-brown">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="#1877F2" viewBox="0 0 24 24">
            <path d="M22 12.07C22 6.5 17.52 2 12 2S2 6.5 2 12.07c0 5 3.66 9.15 8.44 9.93v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.78 8.44-4.93 8.44-9.93z"/>
          </svg>
          Facebook
        </button>
      </div>
    </div>

  </div>
</section>
