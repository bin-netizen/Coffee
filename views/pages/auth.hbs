<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }
}
</script>

<script type="module">
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js'; // thêm dòng này

  const stage = document.getElementById('auth-stage');
  const beanContainer = document.getElementById('bean-stage');
  const MODEL_PATH = '/models/coffee_bean.glb';
  const TARGET_SIZE = 2.2;

  // Không init Three.js trên mobile - bean-stage bị display:none nên clientWidth = 0,
  // init ở đây sẽ ra lỗi chia cho 0 khi tính aspect ratio.
  const isDesktop = window.matchMedia('(min-width: 1024px)').matches;

  if (isDesktop) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      45, beanContainer.clientWidth / beanContainer.clientHeight, 0.1, 1000
    );
    camera.position.set(0, 0, 5);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(beanContainer.clientWidth, beanContainer.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    beanContainer.appendChild(renderer.domElement);

    // Cho phép người dùng kéo chuột/vuốt để xoay hạt cà phê
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;   // xoay có độ trễ mượt, không giật cứng khi thả tay
    controls.dampingFactor = 0.08;
    controls.enableZoom = false;     // tránh xung đột với cuộn trang (scroll wheel)
    controls.enablePan = false;      // không cho kéo lệch vị trí, chỉ xoay tại chỗ

    scene.add(new THREE.AmbientLight(0xffffff, 1.0));
    const dirLight = new THREE.DirectionalLight(0xffffff, 2.5);
    dirLight.position.set(3, 5, 4);
    scene.add(dirLight);
    const fillLight = new THREE.DirectionalLight(0xffffff, 1.0);
    fillLight.position.set(-3, 2, -4);
    scene.add(fillLight);

    let beanModel = null;
    new GLTFLoader().load(
      MODEL_PATH,
      (gltf) => {
        beanModel = gltf.scene;
        const box = new THREE.Box3().setFromObject(beanModel);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);
        const scaleFactor = TARGET_SIZE / maxDim;
        beanModel.scale.setScalar(scaleFactor);
        beanModel.position.sub(center.multiplyScalar(scaleFactor));
        scene.add(beanModel);
      },
      undefined,
      (err) => console.error('Lỗi load model 3D:', err)
    );

    let isVisible = true;
    document.addEventListener('visibilitychange', () => {
      isVisible = document.visibilityState === 'visible';
    });

    function animate() {
      requestAnimationFrame(animate);
      if (!isVisible) return;
      if (beanModel) beanModel.rotation.y += 0.004; // auto-rotate khi không ai kéo
      controls.update(); // thêm dòng này - bắt buộc để damping hoạt động
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      if (!beanContainer.clientWidth) return;
      camera.aspect = beanContainer.clientWidth / beanContainer.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(beanContainer.clientWidth, beanContainer.clientHeight);
    });
  }

  // ===== Chuyển đổi Login <-> Register: fade form + trượt hạt cà phê =====
  function switchMode(target, pushUrl = true) {
    if (stage.dataset.mode === target) return;

    stage.classList.add('is-transitioning'); // fade cả 2 form về opacity 0

    setTimeout(() => {
      stage.dataset.mode = target; // đổi attribute -> CSS tự trigger transform trượt bean
    }, 150);

    setTimeout(() => {
      stage.classList.remove('is-transitioning'); // fade form mới vào lại
    }, 900);

    if (pushUrl) {
      const redirect = new URLSearchParams(window.location.search).get('redirect') || '/';
      const url = `/${target}?redirect=${encodeURIComponent(redirect)}`;
      history.pushState({ mode: target }, '', url);
    }
  }

  document.getElementById('link-to-register')?.addEventListener('click', (e) => {
    e.preventDefault();
    switchMode('register');
  });
  document.getElementById('link-to-login')?.addEventListener('click', (e) => {
    e.preventDefault();
    switchMode('login');
  });

  // Hỗ trợ nút Back/Forward của browser
  window.addEventListener('popstate', () => {
    const path = window.location.pathname;
    switchMode(path.includes('register') ? 'register' : 'login', false);
  });
</script>
