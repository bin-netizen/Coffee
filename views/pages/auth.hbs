{{#if (eq mode "reset-password")}}
<section class="min-h-screen w-full flex items-center justify-center px-6 py-16 auth-bg relative">
  <div class="absolute inset-0 auth-overlay"></div>
  <div class="relative z-10 w-full max-w-md glass-card rounded-3xl p-8 sm:p-12">
    <h1 class="font-heading text-3xl font-bold text-white mb-2">Đặt lại mật khẩu</h1>
    <p class="text-white/60 text-sm mb-8">Nhập mã xác thực đã gửi tới email và mật khẩu mới.</p>

    {{#if successMessage}}
    <div class="bg-green-500/10 border border-green-400/40 text-green-200 text-sm rounded-lg px-4 py-3 mb-4">
      {{successMessage}}
    </div>
    {{/if}}
    {{#if error}}
    <div class="bg-red-500/10 border border-red-400/40 text-red-200 text-sm rounded-lg px-4 py-3 mb-4">
      {{error}}
    </div>
    {{/if}}

    <form action="/reset-password" method="POST" class="space-y-5">
      <input type="hidden" name="email" value="{{email}}" />
      <div>
        <label for="rp-otp" class="block text-sm font-medium text-white/80 mb-2">Mã xác thực (OTP)</label>
        <input type="text" id="rp-otp" name="otp" placeholder="6 chữ số" maxlength="6" inputmode="numeric" pattern="[0-9]{6}"
          class="glass-input w-full px-4 py-3 rounded-lg tracking-[0.5em] text-center" required />
      </div>
      <div>
        <label for="rp-new" class="block text-sm font-medium text-white/80 mb-2">Mật khẩu mới</label>
        <input type="password" id="rp-new" name="newPassword" placeholder="Tối thiểu 8 ký tự"
          class="glass-input w-full px-4 py-3 rounded-lg" required minlength="8" />
      </div>
      <div>
        <label for="rp-confirm" class="block text-sm font-medium text-white/80 mb-2">Nhập lại mật khẩu mới</label>
        <input type="password" id="rp-confirm" name="confirmNewPassword" placeholder="••••••••"
          class="glass-input w-full px-4 py-3 rounded-lg" required minlength="8" />
      </div>
      <button type="submit"
        class="auth-btn w-full bg-accent text-brown font-semibold py-3.5 rounded-full shadow-lg hover:bg-white transition-all duration-300">
        Đổi mật khẩu
      </button>
    </form>

    <p class="text-white/60 text-sm mt-8 text-center">
      Chưa nhận được mã? <a href="/forgot-password" class="text-accent font-semibold hover:underline">Gửi lại</a>
    </p>
  </div>
</section>

