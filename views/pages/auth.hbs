<style>
  /* ===== Nền toàn trang: ảnh login.jpg + overlay tối để chữ đọc được ===== */
  .auth-bg {
    background-image: url('/img/login.jpg');
    background-size: cover;
    background-position: center;
  }
  .auth-overlay {
    background: linear-gradient(to bottom, rgba(0,0,0,0.55), rgba(0,0,0,0.75));
  }

  /* ===== Glass card: trong suốt + viền, theo yêu cầu "hiện đại" ===== */
  .glass-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  .glass-input {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    transition: all 0.3s ease;
  }
  .glass-input::placeholder { color: rgba(255,255,255,0.45); }
  .glass-input:focus {
    outline: none;
    border-color: #c8a27a;
    box-shadow: 0 0 0 3px rgba(200, 162, 122, 0.25);
    background: rgba(255, 255, 255, 0.1);
  }

  .glass-social-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    transition: all 0.25s ease;
  }
  .glass-social-btn:hover {
    background: rgba(255,255,255,0.12);
    border-color: #c8a27a;
  }

  .auth-btn { transition: all 0.3s ease; }
  .auth-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
  }

  /* ===== Khu vực 2 panel cố định: Register = trái, Login = phải ===== */
  #auth-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    max-width: 1100px;
    min-height: 560px;
  }

  /* Mobile: xếp dọc, chỉ hiện form đang active, ẩn hoàn toàn hạt cà phê 3D
     (lý do: tránh vừa vỡ layout vừa nặng GPU trên máy yếu - xem giải thích) */
  @media (max-width: 1023px) {
    #auth-stage { grid-template-columns: 1fr; }
    #bean-stage { display: none !important; }
    .panel-form { display: none; }
    #auth-stage[data-mode="login"] #panel-login { display: block; }
    #auth-stage[data-mode="register"] #panel-register { display: block; }
  }

  /* ===== Desktop: hạt cà phê 3D trượt qua lại ===== */
  @media (min-width: 1024px) {
  #bean-stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    z-index: 20;
    background: rgba(20, 14, 10, 0.72);   /* lớp nền tối phủ kín, che thật form bên dưới */
    backdrop-filter: blur(14px);           /* hiệu ứng kính mờ - nhìn hiện đại hơn nền đặc trơn */
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.4s ease;
  }
    #auth-stage[data-mode="login"] #bean-stage    { transform: translateX(0%); }   /* bean ở TRÁI, che Register */
    #auth-stage[data-mode="register"] #bean-stage { transform: translateX(100%); } /* bean chạy sang PHẢI, che Login */

    /* Panel bị bean che thì tắt tương tác, tránh click xuyên qua khi đang bị phủ */
    #auth-stage[data-mode="login"] #panel-register    { pointer-events: none; }
    #auth-stage[data-mode="register"] #panel-login    { pointer-events: none; }
  }

  /* ===== Hiệu ứng mờ dần khi đang chuyển đổi (áp cho cả 2 form) ===== */
  .panel-form {
    transition: opacity 0.35s ease;
  }
  #auth-stage.is-transitioning .panel-form {
    opacity: 0;
  }
</style>

{{#if (eq mode "forgot-password")}}
<section class="min-h-screen w-full flex items-center justify-center px-6 py-16 auth-bg relative">
  <div class="absolute inset-0 auth-overlay"></div>
  <div class="relative z-10 w-full max-w-md glass-card rounded-3xl p-8 sm:p-12">
    <h1 class="font-heading text-3xl font-bold text-white mb-2">Quên mật khẩu</h1>
    <p class="text-white/60 text-sm mb-8">Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác thực để đặt lại mật khẩu.</p>

    {{#if successMessage}}
    <div class="bg-green-500/10 border border-green-400/40 text-green-200 text-sm rounded-lg px-4 py-3 mb-4">
      {{successMessage}}
    </div>
    {{/if}}
    {{#if error}}
    <div class="bg-red-500/10 border border-red-400/40 text-red-200 text-sm rounded-lg px-4 py-3 mb-4">
      {{error}}
    </div>
    {{/if}}

    <form action="/forgot-password" method="POST" class="space-y-5">
      <div>
        <label for="fp-email" class="block text-sm font-medium text-white/80 mb-2">Email</label>
        <input type="email" id="fp-email" name="email" placeholder="you@example.com"
          class="glass-input w-full px-4 py-3 rounded-lg" required />
      </div>
      <button type="submit"
        class="auth-btn w-full bg-accent text-brown font-semibold py-3.5 rounded-full shadow-lg hover:bg-white transition-all duration-300">
        Gửi mã xác thực
      </button>
    </form>

    <p class="text-white/60 text-sm mt-8 text-center">
      <a href="/login" class="text-accent font-semibold hover:underline">Quay lại đăng nhập</a>
    </p>
  </div>
</section>

