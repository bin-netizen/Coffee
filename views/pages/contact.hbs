>
  <div class="absolute inset-0 bg-gradient-to-b from-brown/70 via-brown/60 to-brown/85"></div>
  <div class="relative z-10 px-4 fade-up">
    <span class="text-accent font-semibold tracking-widest uppercase text-sm">Kết nối với chúng tôi</span>
    <h1 class="font-heading text-5xl md:text-6xl font-bold text-cream mt-4 mb-4 drop-shadow-lg">
      Contact Us
    </h1>
    <p class="text-cream/90 text-lg md:text-xl font-light tracking-wide max-w-xl mx-auto">
      Chúng tôi luôn sẵn sàng lắng nghe bạn
    </p>
  </div>
</section>

