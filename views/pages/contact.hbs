<style>
  .fade-up {
    animation: fadeUp 0.8s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .info-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    border: 1px solid rgba(75, 46, 46, 0.08);
  }
  .info-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 30px rgba(75, 46, 46, 0.2);
    border-color: rgba(200, 162, 122, 0.5);
  }
  .info-icon-ring {
    transition: box-shadow 0.3s ease;
    box-shadow: 0 0 0 0 rgba(200, 162, 122, 0.4);
  }
  .info-card:hover .info-icon-ring {
    box-shadow: 0 0 0 6px rgba(200, 162, 122, 0.15);
  }

  .contact-input {
    transition: all 0.3s ease;
  }
  .contact-input:focus {
    outline: none;
    border-color: #c8a27a;
    box-shadow: 0 0 0 3px rgba(200, 162, 122, 0.25);
  }

  .submit-btn {
    transition: all 0.3s ease;
  }
  .submit-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(75, 46, 46, 0.35);
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-icon {
    transition: transform 0.3s ease;
  }
  .faq-item {
    border: 1px solid rgba(75, 46, 46, 0.06);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .faq-item:hover, .faq-item[open] {
    border-color: rgba(200, 162, 122, 0.5);
    box-shadow: 0 8px 20px rgba(75, 46, 46, 0.12);
  }
  .hero-bg { background-attachment: fixed; }
  @media (max-width: 768px) { .hero-bg { background-attachment: scroll; } }
</style>

