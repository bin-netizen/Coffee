</section>

<!-- ============ FAQ ============ -->
<section class="bg-brown/5 py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-14 fade-up">
      <span class="text-accent font-semibold tracking-widest uppercase text-sm">Giải đáp thắc mắc</span>
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-brown mt-3">Câu hỏi thường gặp</h2>
      <div class="w-20 h-1 bg-accent mx-auto mt-5 rounded-full"></div>
    </div>

    <div class="space-y-4">

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          Coffee có nhận đặt bàn trước không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          Có. Bạn có thể đặt bàn qua form liên hệ phía trên hoặc gọi trực tiếp hotline,
          chúng tôi sẽ xác nhận trong vòng 30 phút.
        </p>
      </details>

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          Có hỗ trợ giao hàng tận nơi không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          Coffee hỗ trợ giao hàng trong bán kính 5km. Bạn có thể đặt hàng trực tiếp
          trên website tại trang Menu.
        </p>
      </details>

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          Coffee có không gian dành cho làm việc nhóm không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          Có khu vực riêng yên tĩnh, wifi tốc độ cao và ổ cắm điện đầy đủ, phù hợp cho
          học tập và làm việc.
        </p>
      </details>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const contactForm = document.getElementById('contactForm');
    const contactFormWrapper = document.getElementById('contactFormWrapper');
    const contactSuccessView = document.getElementById('contactSuccessView');
    const contactSuccessMessage = document.getElementById('contactSuccessMessage');
    const contactError = document.getElementById('contactError');
    const submitBtn = document.getElementById('submitContactBtn');

    contactForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      contactError.classList.add('hidden');

      const payload = {
        name: document.getElementById('name').value.trim(),
        email: document.getElementById('email').value.trim(),
        subject: document.getElementById('subject').value.trim(),
        message: document.getElementById('message').value.trim()
      };

      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Đang gửi...';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (data.success) {
          contactSuccessMessage.textContent = data.message;
          contactFormWrapper.classList.add('hidden');
          contactSuccessView.classList.remove('hidden');
        } else {
          contactError.textContent = data.message || 'Có lỗi xảy ra, vui lòng thử lại.';
          contactError.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }

      } catch (err) {
        console.error('Lỗi khi gửi tin nhắn:', err);
        contactError.textContent = 'Không thể kết nối tới server, vui lòng thử lại.';
        contactError.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  });
</script>
