<!-- ============ CONTACT FORM + MAP ============ -->
<section class="bg-cream pb-20 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

    <!-- Form -->
    <div class="fade-up">
      <span class="text-accent font-semibold tracking-widest uppercase text-sm">Gửi tin nhắn</span>
      <h2 class="font-heading text-4xl font-bold text-brown mt-3 mb-6">Liên hệ với chúng tôi</h2>
      <p class="text-brown/70 mb-8 leading-relaxed">
        Có câu hỏi, góp ý hay muốn đặt bàn? Điền thông tin bên dưới, đội ngũ Coffee
        sẽ phản hồi bạn trong thời gian sớm nhất.
      </p>

      <div id="contactFormWrapper">
        <form id="contactForm" action="/contact" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-brown mb-2">Họ và tên</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Nguyễn Văn A"
                class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-brown mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
                required
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-brown mb-2">Chủ đề</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Đặt bàn / Góp ý / Hợp tác..."
              class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-brown mb-2">Nội dung</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Nhập nội dung tin nhắn của bạn..."
              class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40 resize-none"
              required
            ></textarea>
          </div>

          <p id="contactError" class="text-red-600 text-sm hidden"></p>

          <button
            id="submitContactBtn"
            type="submit"
            class="submit-btn bg-brown text-cream font-semibold px-8 py-3.5 rounded-full shadow-lg hover:bg-accent hover:text-brown transition-all duration-300"
          >
            Gửi tin nhắn
          </button>
        </form>
      </div>

      <!-- Màn hình xác nhận, hiện ra thay cho form sau khi gửi thành công -->
      <div id="contactSuccessView" class="hidden fade-up text-center py-10 bg-white/60 rounded-2xl">
        <div class="w-16 h-16 flex items-center justify-center bg-green-100 rounded-full mx-auto mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="font-heading text-2xl font-bold text-brown mb-2">Đã gửi tin nhắn thành công!</h3>
        <p class="text-brown/70 max-w-sm mx-auto px-4" id="contactSuccessMessage">
          Cảm ơn bạn đã liên hệ! Chúng tôi đã ghi nhận tin nhắn và sẽ phản hồi sớm nhất.
        </p>
      </div>
    </div>

    <!-- Map + Hours -->
    <div class="fade-up space-y-8">
      <div class="rounded-2xl overflow-hidden shadow-xl h-[320px]">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=106.68%2C10.75%2C106.72%2C10.79&layer=mapnik"
