<!-- ============ CONTACT FORM + MAP ============ -->
<section class="bg-cream pb-20 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

    <!-- Form -->
    <div class="fade-up">
      <span class="text-accent font-semibold tracking-widest uppercase text-sm">Gửi tin nhắn</span>
      <h2 class="font-heading text-4xl font-bold text-brown mt-3 mb-6">Liên hệ với chúng tôi</h2>
      <p class="text-brown/70 mb-8 leading-relaxed">
        Có câu hỏi, góp ý hay muốn đặt bàn? Điền thông tin bên dưới, đội ngũ CoffeeWeb
        sẽ phản hồi bạn trong thời gian sớm nhất.
      </p>

      <form action="/contact" method="POST" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-brown mb-2">Họ và tên</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Nguyễn Văn A"
              class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
              required
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-brown mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
              required
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-brown mb-2">Chủ đề</label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="Đặt bàn / Góp ý / Hợp tác..."
            class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-brown mb-2">Nội dung</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Nhập nội dung tin nhắn của bạn..."
            class="contact-input w-full px-4 py-3 rounded-lg border border-brown/20 bg-white/70 text-brown placeholder-brown/40 resize-none"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="submit-btn bg-brown text-cream font-semibold px-8 py-3.5 rounded-full shadow-lg hover:bg-accent hover:text-brown transition-all duration-300"
        >
          Gửi tin nhắn
        </button>
      </form>
    </div>

    <!-- Map + Hours -->
    <div class="fade-up space-y-8">
      <div class="rounded-2xl overflow-hidden shadow-xl h-[320px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.4!2d106.7!3d10.77!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1svi!2s!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="CoffeeWeb Location"
        ></iframe>
      </div>

      <div class="bg-brown text-cream rounded-2xl p-8 shadow-xl">
        <h3 class="font-heading text-xl font-semibold mb-5">Giờ mở cửa</h3>
        <ul class="space-y-3 text-cream/85 text-sm">
          <li class="flex justify-between border-b border-cream/10 pb-3">
            <span>Thứ Hai - Thứ Sáu</span>
            <span class="font-medium text-accent">7:00 - 22:00</span>
          </li>
          <li class="flex justify-between border-b border-cream/10 pb-3">
            <span>Thứ Bảy</span>
            <span class="font-medium text-accent">8:00 - 23:00</span>
          </li>
          <li class="flex justify-between">
            <span>Chủ Nhật</span>
            <span class="font-medium text-accent">8:00 - 21:00</span>
          </li>
        </ul>
      </div>
    </div>

  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="bg-brown/5 py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-14 fade-up">
      <span class="text-accent font-semibold tracking-widest uppercase text-sm">Giải đáp thắc mắc</span>
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-brown mt-3">Câu hỏi thường gặp</h2>
      <div class="w-20 h-1 bg-accent mx-auto mt-5 rounded-full"></div>
    </div>

    <div class="space-y-4">

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          CoffeeWeb có nhận đặt bàn trước không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          Có. Bạn có thể đặt bàn qua form liên hệ phía trên hoặc gọi trực tiếp hotline,
          chúng tôi sẽ xác nhận trong vòng 30 phút.
        </p>
      </details>

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          Có hỗ trợ giao hàng tận nơi không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          CoffeeWeb hỗ trợ giao hàng trong bán kính 5km. Bạn có thể đặt hàng trực tiếp
          trên website tại trang Menu.
        </p>
      </details>

      <details class="faq-item bg-white/70 rounded-xl p-6 shadow-sm">
        <summary class="flex items-center justify-between font-heading text-lg font-semibold text-brown">
          CoffeeWeb có không gian dành cho làm việc nhóm không?
          <span class="faq-icon text-accent text-2xl leading-none">+</span>
        </summary>
        <p class="text-brown/70 mt-4 leading-relaxed">
          Có khu vực riêng yên tĩnh, wifi tốc độ cao và ổ cắm điện đầy đủ, phù hợp cho
          học tập và làm việc.
        </p>
      </details>

    </div>
  </div>
</section>
