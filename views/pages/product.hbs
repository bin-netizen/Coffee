<section class="product-detail">
  <div class="product-image">
    <img src="{{product.image}}" alt="{{product.name}}">
  </div>
  <div class="product-info">
    <h2>{{product.name}}</h2>
    <p class="price">{{product.price}} VND</p>
    <p class="description">
      {{product.name}} là một loại cà phê đặc biệt, được pha chế từ hạt cà phê nguyên chất,
      mang lại hương vị đậm đà và tinh tế. Thích hợp cho mọi thời điểm trong ngày.
    </p>
    <button onclick="addToCart({{product.id}}, '{{product.name}}', {{product.price}})" class="btn">
      Add to Cart
    </button>
  </div>
</section>
